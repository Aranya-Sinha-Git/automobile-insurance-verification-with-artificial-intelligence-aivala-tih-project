# Copy to .env.local and fill in device/account-specific values.
AIVALA_ENABLE_TUNNEL=0
AIVALA_SKIP_TUNNEL=0
NGROK_REGION=ap
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-persistent-dev-domain.ngrok-free.dev
QWEN_MODEL_ID=Qwen/Qwen3-VL-4B-Instruct
QWEN_LOAD_IN_4BIT=1
# The launcher sets HF_HUB_OFFLINE=1 only after the base model cache passes preflight.
HF_HUB_OFFLINE=0
AIVALA_ALLOWED_ORIGINS=capacitor://localhost,http://localhost,https://localhost,http://localhost:3000,http://localhost:5173
DEV_TESTING_MODE=false
AIVALA_AUTH_REQUIRED=false
# Production only: use workload/application credentials or inject this server-only JSON value.
FIREBASE_SERVICE_ACCOUNT_JSON=
AIVALA_AUDIT_KEY_ID=local-dev
AIVALA_SECURITY_DB=
AIVALA_FFMPEG_BIN=
# Keep YOLO and Qwen bound to loopback unless intentionally fronted by a trusted proxy.
AIVALA_INTERNAL_HOST=127.0.0.1
AIVALA_SECURITY_PORT=8010
AIVALA_AUDIT_SECRET=
